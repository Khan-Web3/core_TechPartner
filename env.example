# Copy this file to .env.local and fill in your values.
# For Mailtrap testing now; switch host/user/pass later for Hostinger.

SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=YOUR_MAILTRAP_API_TOKEN

# From address (Mailtrap may require a verified sender in production SMTP)
SMTP_FROM="Core Tech Partner <info@coretechpartner.com>"

# Where inquiry emails should be delivered
CONTACT_TO=info@coretechpartner.com
